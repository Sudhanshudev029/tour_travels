# Copy to .env for local testing. For production add the same keys in Netlify → Site configuration → Environment variables.

# ---- Browser-visible (public) ----
VITE_BUSINESS_NAME=
VITE_PHONE=
# Digits only, international format without "+". Defaults to the client number.
VITE_WHATSAPP_NUMBER=
VITE_EMAIL=

# ---- Server-only secrets (NEVER prefix with VITE_) — used by Nodemailer in /api/enquiry ----
# Sending account. For Gmail: enable 2-Step Verification, then create an App Password at https://myaccount.google.com/apppasswords
SMTP_USER=
SMTP_PASS=
# Inbox that receives enquiries (defaults to viakashitours@gmail.com)
ENQUIRY_TO=
# Optional: SMTP_HOST (default smtp.gmail.com), SMTP_PORT (default 465), MAIL_FROM
